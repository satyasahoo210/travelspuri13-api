{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "prisma/generated/prisma/**",
        "outDir": "dist"
      },
      {
        "include": "prisma/generated/prisma/*",
        "outDir": "dist"
      },
      {
        "include": "modules/booking/assets/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}